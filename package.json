{
  "name": "tracebac",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A chat agent whose memory is a ledger of dated, sourced, re-checkable claims.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "predev": "node check-node.mjs",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning src/index.ts",
    "typecheck": "tsc -p .",
    "replay": "node scripts/replay.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
