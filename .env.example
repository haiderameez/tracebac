# tracebac needs at least ONE model key and ONE search key. All are free and none needs a credit card.
# Set more than one of either to get the fallback chain: when a provider rate-limits, the next one answers.
# Free-tier limits change; these were read from each provider's docs in November 2026.

# ---------- models (at least one) ----------

# Groq: fast small model for routing. Free: 30 requests/min, 1,000 requests/day, 8,000 tokens/min per model
# https://console.groq.com/keys
GROQ_API_KEY=

# Cerebras: very fast structured output and a fallback writer. Free: 5 requests/min, 30,000 tokens/min, 1M tokens/day
# https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Google AI Studio (Gemini): main writer. Flash models are free, per-model limits are only shown inside AI Studio.
# Free-tier prompts may be used by Google to improve its products.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter: works on its own for every role, and is the last fallback when others are set.
# Free models: 20 requests/min, 50 requests/day (about 12 searched answers a day on its own)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ---------- web search (at least one) ----------

# Tavily: main search. Free: 1,000 credits/month, a basic search costs 1 credit
# https://app.tavily.com
TAVILY_API_KEY=

# Exa: search fallback. Free: $10 of credit that resets monthly
# https://dashboard.exa.ai
EXA_API_KEY=

# Serper: search fallback. Free: 2,500 queries to start
# https://serper.dev
SERPER_API_KEY=

# ---------- page reading ----------

# Jina Reader: OPTIONAL. Pages are read without a key at 20 requests/min. A free key raises that to 500/min
# https://jina.ai/reader
JINA_API_KEY=

# ---------- server ----------

PORT=3000

# Lets a request carry a simulated "now", so questions about "last Tuesday" can be tested without waiting a week.
ALLOW_CLOCK_OVERRIDE=false
